{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "doulo-dev",
  "compatibility_date": "2026-07-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
  "directory": "./public"
    // When you're ready for Worker logic, add:
    //   "main": "src/index.ts"   (top-level, next to "assets")
    //   "binding": "ASSETS"      (here, to fetch assets from the Worker)
  },
  "observability": {
    "enabled": true
  }
}
